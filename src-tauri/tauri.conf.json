{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Bookify",
  "version": "1.0.0",
  "identifier": "com.bookify.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bookify — Studio Letterario",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "backgroundColor": "#191612"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.anthropic.com https://generativelanguage.googleapis.com https://api.openai.com https: http://localhost:* http://127.0.0.1:*"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Violet M.",
    "copyright": "© 2026 Violet M. — MIT License",
    "category": "Productivity",
    "shortDescription": "Studio di scrittura per romanzieri",
    "longDescription": "Bookify è uno studio di scrittura senza distrazioni per romanzieri: modalità macchina da scrivere, suoni di tastiera meccanica, Bibbia del romanzo e un editor letterario AI (Claude, Gemini, OpenAI o Ollama).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
